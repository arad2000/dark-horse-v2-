+def set_marketer_rate(
+    db: Session,
+    actor: User,
+    *,
+    marketer_id: int,
+    commission_bps: int,
+) -> ReferralMarketer:
+    """Change what future orders owe this marketer.
+
+    Orders already placed keep the rate snapshotted on them, so a correction here
+    can never rewrite a settled or accrued amount.
+    """
+    _require_manager(actor)
+    bps = int(commission_bps)
+    if not (0 <= bps <= BASIS_POINTS):
+        raise ValueError("commission_bps must be between 0 and 10000")
+
+    marketer = db.get(ReferralMarketer, int(marketer_id))
+    if marketer is None:
+        raise LookupError("marketer not found")
+
+    marketer.commission_bps = bps
+    db.flush()
+    return marketer
+
