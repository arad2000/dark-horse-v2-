+<script>
+(function () {
+  'use strict';
+
+  var API = 'https://api.asbe-siah.ir';
+  var auth = null;
+  try { auth = JSON.parse(localStorage.getItem('dh_auth_v1') || 'null'); } catch (_) {}
+
+  function el(id) { return document.getElementById(id); }
+  function toFa(n) { return String(n == null ? '' : n).replace(/\d/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'[Number(d)]; }); }
+  function money(n) { return toFa(String(Math.round(Number(n || 0))).replace(/\B(?=(\d{3})+(?!\d))/g, '٬')); }
+  function text(v) {
+    return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) {
+      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
+    });
+  }
+  function token() { return (auth && auth.token) || ''; }
+
+  function req(path, opts) {
+    opts = opts || {};
+    opts.headers = opts.headers || {};
+    opts.headers['Authorization'] = 'Bearer ' + token();
+    if (opts.body) opts.headers['Content-Type'] = 'application/json';
+    return fetch(API + path, opts).then(function (r) {
+      return r.text().then(function (raw) {
+        var body = null;
+        try { body = raw ? JSON.parse(raw) : null; } catch (_) {}
+        if (!r.ok) {
+          var msg = (body && (body.detail || body.message)) || ('خطا ' + r.status);
+          if (typeof msg !== 'string') msg = JSON.stringify(msg);
+          throw new Error(msg);
+        }
+        return body;
+      });
+    });
+  }
+
+  function fail(msg) { el('error').textContent = msg || ''; }
+
+  el('logout').onclick = function () {
+    try {
+      localStorage.removeItem('dh_auth_v1');
+      localStorage.removeItem('dh_local_user_v1');
+      localStorage.removeItem('dh_local_quota_v1');
+    } catch (_) {}
+    window.location.replace('index.html?logout=1');
+  };
+
+  function loadAll() {
+    fail('');
+    return Promise.all([
+      req('/api/v1/admin/marketers/report'),
+      req('/api/v1/admin/referrals/report')
+    ]).then(function (res) {
+      var report = res[0] || {};
+      var totals = report.totals || {};
+      el('t-marketers').textContent = toFa(totals.marketers || 0);
+      el('t-signups').textContent = toFa(totals.signups || 0);
+      el('t-confirmed').textContent = toFa(totals.confirmed_buyers || 0);
+      paintMarketers(report.marketers || []);
+    }).catch(function (e) { fail(e.message); });
+  }
+
+  function sumCurrencies(list, key) {
+    var total = 0;
+    (list || []).forEach(function (c) { total += Number(c[key] || 0); });
+    return total;
+  }
+
+  function paintMarketers(rows) {
+    var body = el('marketers');
+    body.innerHTML = '';
+    el('mk-empty').classList.toggle('hide', rows.length > 0);
+    rows.forEach(function (m) {
+      var tr = document.createElement('tr');
+      var rate = m.commission_bps ? toFa(m.commission_percent) + '٪' : '—';
+      tr.innerHTML =
+        '<td>' + text(m.name) + (m.self_service ? ' <span class="tag self">خودساخته</span>' : '') + '</td>' +
+        '<td class="mono">' + text(m.phone || '—') + '</td>' +
+        '<td>' + rate + '</td>' +
+        '<td>' + toFa(m.signups) + '</td>' +
+        '<td>' + toFa(m.confirmed_buyers) + '</td>' +
+        '<td>' + money(sumCurrencies(m.currencies, 'accrued_amount_minor')) + '</td>' +
+        '<td>' + money(sumCurrencies(m.currencies, 'settled_amount_minor')) + '</td>' +
+        '<td></td>';
+      var btn = document.createElement('button');
+      btn.type = 'button';
+      btn.className = 'ghost';
+      btn.textContent = 'افراد';
+      btn.onclick = function () { showDetail(m); };
