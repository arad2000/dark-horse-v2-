+  }
+
+  function showDetail(m) {
+    el('detail-panel').classList.remove('hide');
+    el('detail-title').textContent = 'افراد آورده‌شده توسط ' + m.name;
+    el('detail-rows').innerHTML = '<tr><td colspan="6" class="empty">در حال بارگذاری…</td></tr>';
+    req('/api/v1/admin/marketers/' + m.marketer_id + '/signups').then(function (d) {
+      var people = d.people || [];
+      if (!people.length) {
+        el('detail-rows').innerHTML = '<tr><td colspan="6" class="empty">هنوز کسی با کد این بازاریاب ثبت‌نام نکرده است.</td></tr>';
+        return;
+      }
+      el('detail-rows').innerHTML = people.map(function (p) {
+        return '<tr>' +
+          '<td>' + text(p.name) + '</td>' +
+          '<td class="mono">' + text(p.phone) + '</td>' +
+          '<td><span class="code-chip">' + text(p.code) + '</span></td>' +
+          '<td>' + text(p.joined_at ? p.joined_at.slice(0, 10) : '—') + '</td>' +
+          '<td>' + toFa(p.paid_orders) + '</td>' +
+          '<td>' + (p.confirmed ? '<span class="tag on">خرید کرده</span>' : '<span class="tag off">فقط ثبت‌نام</span>') + '</td>' +
+          '</tr>';
+      }).join('');
+    }).catch(function (e) {
+      el('detail-rows').innerHTML = '<tr><td colspan="6" class="err">' + text(e.message) + '</td></tr>';
+    });
+  }
+
+  el('detail-close').onclick = function () { el('detail-panel').classList.add('hide'); };
+  el('refresh').onclick = loadAll;
+
+  el('add-marketer').onclick = function () {
+    var name = el('m-name').value.trim();
+    var phone = el('m-phone').value.trim();
+    var rate = parseFloat(el('m-rate').value || '0');
+    var code = el('m-code').value.trim().toUpperCase();
+    el('add-msg').textContent = '';
+    fail('');
+    if (name.length < 2) { fail('نام بازاریاب را وارد کنید.'); return; }
+    if (!(rate >= 0 && rate <= 100)) { fail('درصد باید بین ۰ و ۱۰۰ باشد.'); return; }
+
+    var btn = el('add-marketer');
+    btn.disabled = true;
+    req('/api/v1/admin/marketers', {
+      method: 'POST',
+      body: JSON.stringify({
+        name: name,
+        phone: phone || null,
+        commission_bps: Math.round(rate * 100)
+      })
+    }).then(function (mk) {
+      if (!code) return null;
+      return req('/api/v1/admin/marketers/codes', {
+        method: 'POST',
+        body: JSON.stringify({ marketer_id: mk.id, code: code })
+      });
+    }).then(function () {
+      el('add-msg').textContent = 'ثبت شد.';
+      el('m-name').value = ''; el('m-phone').value = ''; el('m-rate').value = ''; el('m-code').value = '';
+      return loadAll();
+    }).catch(function (e) {
+      fail(e.message);
+    }).then(function () { btn.disabled = false; });
+  };
+
+  req('/api/v1/me').then(function (me) {
+    var role = me && me.user && me.user.role;
+    if (role !== 'admin' && role !== 'support') throw new Error('دسترسی این صفحه برای این حساب مجاز نیست.');
+    el('who').textContent = 'کاربر: ' + ((me.user && me.user.name) || '—') + ' · نقش: ' + role;
+    el('app').classList.remove('hide');
+    loadAll();
+  }).catch(function (e) { fail(e.message); });
+})();
+</script>
+</body>
+</html>
